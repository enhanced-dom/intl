{
  "name": "@enhanced-dom/intl",
  "version": "0.3.0",
  "description": "Utilities for managing translation keys inside the app",
  "keywords": [],
  "repository": "https://github.com/enhanced-dom/intl.git",
  "license": "MIT",
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "type": "module",  
  "main": "translations.js",
  "scripts": {
    "configure-claude": "@enhanced-dom-claude --configs react code agent rtk devcontainer caveman-lite",
    "configure-lint": "@enhanced-dom-fallow --gitignore && @enhanced-dom-npmrc --gitignore && @enhanced-dom-nvmrc --gitignore && @enhanced-dom-husky --gitignore",
    "configure-build": "@enhanced-dom-bootstrap-tsconfig",
    "prepare": "npm run configure-lint && npm run configure-claude && npm run configure-build",
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "postbuild": "tsc-esm-fix --target=dist && copyfiles LICENSE.md README.md dist && @enhanced-dom-copy-packagejson",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",    
    "package": "cd dist && npm pack",
    "lint": "eslint --fix --config eslint.config.mjs src test",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --config test/jest.config.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@enhanced-dom/webpack": "^0.5.1",
    "lodash-es": "^4.18.1",
    "require-from-string": "^2.0.2",
    "schema-utils": "^4.5.0",
    "@babel/helper-plugin-utils": "^7.29.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@enhanced-dom/babel": "^0.3.0",
    "@enhanced-dom/claude": "^0.3.1",
    "@enhanced-dom/jest": "^0.3.0",
    "@enhanced-dom/lint": "^0.4.2",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.5",
    "@types/require-from-string": "^1.2.3",
    "@types/webpack": "^5.28.5"
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
